# Copy this file to .env and fill in real values before running the application.
# Never commit .env with real credentials to source control.

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/music_streaming
DB_USERNAME=music_streaming
DB_PASSWORD=change_me_before_running

# Optional: override default PostgreSQL Docker port
# POSTGRES_PORT=5432

# Spring Security — default user generated by Spring Boot if no UserDetailsService is configured.
# Override via spring.security.user.name / spring.security.user.password in your environment.
